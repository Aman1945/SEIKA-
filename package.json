{
  "name": "seika",
  "version": "0.1.0",
  "private": true,
  "description": "SEIKA Gaming Zone OS — enterprise-grade gaming zone operating system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @seika/api dev",
    "dev:api:mem": "pnpm --filter @seika/api dev:mem",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20"
  }
}
