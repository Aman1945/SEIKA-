{
  "name": "seika",
  "version": "0.1.0",
  "private": true,
  "description": "SEIKA Gaming Zone OS \u2014 enterprise-grade gaming zone operating system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @seika/api dev",
    "dev:api:mem": "pnpm --filter @seika/api dev:mem",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "dev:dashboard": "pnpm --filter @seika/dashboard dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @seika/api test && pnpm --filter @seika/kiosk test",
    "dev:player": "pnpm --filter @seika/player dev"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20"
  }
}
