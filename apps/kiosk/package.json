{
  "name": "@seika/kiosk",
  "version": "0.1.0",
  "private": true,
  "description": "SEIKA PC Client \u2014 Windows kiosk lock for gaming PCs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "test": "node --test test/*.test.js",
    "dist:all": "electron-builder --win --x64 --arm64"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "gg.seika.kiosk",
    "productName": "SEIKA",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "windows",
        "to": "windows",
        "filter": [
          "**/*.ps1"
        ]
      },
      {
        "from": "config.example.js",
        "to": "config.example.js"
      }
    ]
  }
}
