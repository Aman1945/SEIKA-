{
  "name": "@seika/kiosk",
  "version": "0.1.0",
  "private": true,
  "description": "SEIKA PC Client — Windows kiosk lock for gaming PCs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "gg.seika.kiosk",
    "productName": "SEIKA",
    "files": ["main.js", "preload.js", "src/**/*", "renderer/**/*", "package.json"],
    "win": {
      "target": ["nsis"],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
