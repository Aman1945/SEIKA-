# Copy to .env and fill. In dev you can instead run `pnpm dev:mem` (in-memory Mongo).
NODE_ENV=development
PORT=4000

# MongoDB — must be a replica set (transactions). With Docker Compose:
MONGO_URI=mongodb://localhost:27017/seika?replicaSet=rs0
# Set true to spin up an in-memory MongoDB replica set (no Docker needed).
SEIKA_USE_MEMORY_DB=false

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production. The server refuses to boot if these are missing or
# still set to the dev defaults. Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300

# ─── OTP delivery ────────────────────────────────────────────────────────────
# console = dev only (code is logged, nothing is sent).
# Production must be msg91 | twilio | resend, or the server refuses to boot —
# without it nobody can receive a login code.
OTP_PROVIDER=console

# MSG91 (India-first SMS — cheapest for the pilot zone)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SEIKA

# Twilio (SMS fallback / international numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend (email OTP — staff logins). If RESEND_API_KEY is set, email
# identifiers use it automatically even when OTP_PROVIDER is an SMS provider.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@seika.gg

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Decoupled from NODE_ENV so staging can exercise the same path production
# does (testing plan case M7). Defaults: on in production, off in dev.
RATE_LIMIT_ENABLED=false

# ─── Payments ────────────────────────────────────────────────────────────────
# Without key id + secret the payment service runs in mock mode (dev only —
# production boot fails). The webhook secret is REQUIRED in production: a dev
# default would let anyone forge a top-up.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret

# Google OAuth (not implemented yet — only the googleId field exists)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Production boot fails if this still contains localhost.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Redis (optional, recommended in production) ─────────────────────────────
# Without it, rate-limit windows live in one process's memory — which means an
# attacker gets the full quota per API instance behind a load balancer.
REDIS_URL=

# ─── Observability ───────────────────────────────────────────────────────────
# Absent = no error reporting. Production boots with a warning, because a
# failure nobody is told about is found by a customer.
SENTRY_DSN=
# Git sha or tag, so a crash report names the build it came from. The deploy
# script sets this automatically.
SEIKA_RELEASE=dev
